{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "title",
    "description",
    "author",
    "license",
    "workActivity",
    "minimumProtocol",
    "dependencies",
    "defaults",
    "customisable"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9._-]{1,80}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "workActivity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "minimumProtocol": {
      "const": 1
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "minimumVersion"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9._-]{1,80}$"
          },
          "minimumVersion": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workSeconds",
        "breakSeconds",
        "trigger",
        "selection",
        "quiet",
        "repeat"
      ],
      "properties": {
        "workSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 14400
        },
        "breakSeconds": {
          "type": "integer",
          "minimum": 20,
          "maximum": 300
        },
        "trigger": {
          "enum": [
            "manual",
            "interval",
            "screen"
          ]
        },
        "selection": {
          "enum": [
            "rotation",
            "fixed",
            "choose"
          ]
        },
        "quiet": {
          "type": "boolean"
        },
        "repeat": {
          "type": "boolean"
        }
      }
    },
    "customisable": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "workSeconds",
          "breakSeconds",
          "trigger",
          "selection",
          "quiet",
          "repeat"
        ]
      }
    }
  }
}
